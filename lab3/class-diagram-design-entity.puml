@startuml D-Fence-DesignEntity
' v0.2 (2026-09-16) - cross-pest generalisation, REQUIREMENTS.md v0.9:
'   +PestProfile, +ObservationRecord, +VectorControlOperator, +Referral;
'   +PestType, +PestClass, +EvidenceTier, +LocationContext enumerations;
'   Report gains pestType / locationContext / injuryReported;
'   WorkOrder gains pestType; PriorityTier gains Critical.
' D-Fence — Design class model, entity and persistence layers (Lab 3 deliverable 2, part 1b)
' Transformed from lab2/class-diagram-entity.puml. The 23 analysis entities keep their names;
' what is added here is types, visibility, operations, container classes and the persistence
' relationships — Fox pp. 341-345 heuristics 2, 5, 6 and 7.

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle

package "Entity — domain model" #F7F7F7 {
  class Account <<entity>> {
    + id : Uuid
    + email : string
    + authUserId : AuthUserId
    + emailVerified : boolean
    + role : Role
    + isActive : boolean
    - failedAttempts : number
    - lockedUntil : Date
    + telegramChatId : string
    + createdAt : Date
    + isLocked(now : Date) : boolean
    + canAssume(role : Role) : boolean
  }

  class SavedLocation <<entity>> {
    + id : Uuid
    + accountId : Uuid
    + inputText : string
    + point : GeoPoint
    + label : LocationLabel
    + name : string
    + exposureStatus : ExposureStatus
    + rain24hMm : number
    + rain72hMm : number
    + evaluatedAt : Date
    + isExposed() : boolean
  }

  class Cluster <<entity>> {
    + id : Uuid
    + objectId : string
    + locality : string
    + boundary : Polygon
    + caseSize : number
    + premisesMix : PremisesMix
    + caseDelta : number
    + changeClass : ChangeClass
    + forecastRegion : ForecastRegion
    + heavyRainExpected : boolean
    + trajectory : Trajectory
    + firstSeenAt : Date
    + lastUpdatedAt : Date
    + isActive : boolean
    + latestSnapshot() : ClusterSnapshot
    + deltaOver(days : number) : number
    + daysSinceLastTreatment(now : Date) : number
  }

  class ClusterSnapshot <<entity>> {
    + id : Uuid
    + clusterId : Uuid
    + retrievedAt : Date
    + caseSize : number
    + boundary : Polygon
    + differsFrom(other : ClusterSnapshot) : boolean
  }

  class PriorityScore <<entity>> {
    + id : Uuid
    + clusterId : Uuid
    + localityId : Uuid
    + pestType : PestType
    + computedAt : Date
    + urgency : number
    + severityMultiplier : number
    + score : number
    + tier : PriorityTier
    + evidenceTier : EvidenceTier
    + overrideRuleName : string
    + isDegraded : boolean
    + excludedDrivers : Driver[]
    + rank : number
    + breakdown() : DriverContribution[]
    + explain() : string
    + isCritical() : boolean
  }

  class DriverContribution <<entity>> {
    + driver : Driver
    + rawValue : number
    + normalisedValue : number
    + weight : number
    + contribution : number
  }

  class Report <<entity>> {
    + id : Uuid
    + reporterId : Uuid
    + point : GeoPoint
    + type : ReportType
    + pestType : PestType
    + locationContext : LocationContext
    + injuryReported : boolean
    + description : string
    + clusterId : Uuid
    + status : ReportStatus
    + corroborationCount : number
    + submittedAt : Date
    + moderatedAt : Date
    + moderationReason : string
    + isOpen() : boolean
    + isVerified() : boolean
  }

  class Vehicle <<entity>> {
    + id : string
    + registration : string
    + name : string
    + model : string
    + photoUrl : string
    + hqLocation : HqLocation
    + maxPayloadKg : number
    + maxCargoVolumeM3 : number
    + cargoLengthCm : number
    + cargoWidthCm : number
    + cargoHeightCm : number
    + seatCapacity : number
    + isAvailable : boolean
    + isDemo : boolean
    + isAvailableForService() : boolean
  }

  class WorkOrder <<entity>> {
    + id : Uuid
    + clusterId : Uuid
    + pestType : PestType
    + assigneeId : Uuid
    + sourceReportId : Uuid
    + taskType : TaskType
    + scheduledDate : IsoDate
    + priority : PriorityTier
    + instructions : string
    - status : WorkOrderStatus
    + startedAt : Date
    + cancellationReason : string
    + issueFlag : boolean
    + issueReason : string
    + vehicleId : string
    + stopOrder : number
    + isFixed : boolean
    + currentStatus() : WorkOrderStatus
    + applyStatus(next : WorkOrderStatus) : void
    + isOverdue(now : Date) : boolean
    + isTerminal() : boolean
  }

  class TreatmentRecord <<entity>> {
    + id : Uuid
    + clusterId : Uuid
    + workOrderId : Uuid
    + taskType : TaskType
    + completionDate : IsoDate
  }

  class Alert <<entity>> {
    + id : Uuid
    + savedLocationId : Uuid
    + triggerType : AlertTrigger
    + sentAt : Date
    + outcome : DeliveryOutcome
    + payload : string
  }

  class AuditRecord <<entity>> {
    + id : Uuid
    + accountId : Uuid
    + action : string
    + targetEntity : string
    + targetId : Uuid
    + occurredAt : Date
  }

  class PestProfile <<entity>> {
    + pestType : PestType
    + pestClass : PestClass
    + evidenceTier : EvidenceTier
    + severityMultiplier : number
    + driverWeights : Map<Driver, number>
    + dispatchAuthority : string
    + authorityContactNumber : string
    + observationTaxonId : number
    + drivers() : Driver[]
    + weightsSumToOne() : boolean
    + isReferrable() : boolean
  }

  class ObservationRecord <<entity>> {
    + observationId : string
    + pestType : PestType
    + observedOn : IsoDate
    + point : GeoPoint
    + positionalAccuracy : number
    + qualityGrade : string
    + localityId : Uuid
    + retrievedAt : Date
    + isWithin(days : number, now : Date) : boolean
  }

  class VectorControlOperator <<entity>> {
    + companyName : string
    + blockOrHouseNo : string
    + streetName : string
    + postalCode : string
    + telephoneNo : string
    + point : GeoPoint
    + isGeocoded() : boolean
  }

  class Referral <<entity>> {
    + id : Uuid
    + reportId : Uuid
    + destinationAuthority : string
    + referredAt : Date
    + referredBy : Uuid
    + reason : string
    + outcome : string
    + outcomeRecordedAt : Date
    + isClosed() : boolean
  }

  note bottom of Account
    Supabase Auth owns the credential: there is no
    passwordHash here. 2.1.7 and 10.3.1 are still met —
    the hash lives in the auth schema of the same
    database — but this row is a profile, joined to the
    provider identity by authUserId.
    failedAttempts and lockedUntil stay ours, because
    2.1.10 is specified more precisely than any provider
    setting expresses.
  end note

  note bottom of PestProfile
    **PestProfile is configuration, not user data** (4.2.2,
    10.6.2). It is an entity because it is read at scoring
    time like any other, but it is loaded from
    config/pest-profiles.default.json and never written by
    a use case. 4.2.7 refuses a catalogue in which no pest
    carries severityMultiplier 1.0 — the multipliers are
    normalised against the most severe pest, and the tier
    thresholds in 4.1.8 mean what they meant in v0.8 only
    while that holds.
  end note

  note bottom of ObservationRecord
    **Not a Report.** A Report has a reporter, a status and
    accountability; an observation has none of the three. It
    is a naturalist's sighting retrieved under 1.5, and
    4.1.26 forbids labelling it as pest pressure anywhere it
    is shown. Records whose supplier obscured the
    coordinates are never stored (1.5.6) — obscuring
    randomises the point within roughly a 22 km box, so it
    cannot be attributed to a locality at all.
  end note

  note bottom of Referral
    **A referral writes no TreatmentRecord and no WorkOrder**
    (8.6.10, 8.6.11). The locality was not treated. Recording
    treatment recency the system did not earn would corrupt
    the 4.1.17 feedback loop, which is the one thing that
    makes a score fall after work is done.
  end note

  note bottom of WorkOrder
    status is private with no public setter.
    applyStatus() is package-visible in effect: it is
    called only by WorkOrderLifecycleController, which
    validates the transition first. This is 8.3.2
    enforced by encapsulation rather than by convention.
  end note

  note bottom of Cluster
    The other twelve entity classes — Session,
    AlertSubscription, ReportPhoto, Corroboration,
    CompletionEvidence, RainfallStation, RainfallReading,
    ClusterRainfall, RegionForecast, IngestionRun,
    SourceHealth, Configuration — keep the attributes
    given in lab1/submission/DATA-DICTIONARY.md and are
    typed in src/entity. They are omitted here only to
    keep the diagram readable.
  end note
}

package "Value types (heuristic 5)" #FDFDF7 {
  class GeoPoint <<value>> {
    + latitude : number
    + longitude : number
    + distanceTo(other : GeoPoint) : number
  }
  class Polygon <<value>> {
    + rings : GeoPoint[][]
    + contains(p : GeoPoint) : boolean
    + toGeoJson() : string
  }
  class PremisesMix <<value>> {
    + homes : number
    + publicPlaces : number
    + constructionSites : number
    + total() : number
  }
  class TierThresholds <<value>> {
    + high : number
    + medium : number
  }
}

package "Persistence — repositories (heuristics 6 and 7)" #F7FAFD {
  interface Repository <<interface>> {
    + findById(id : Uuid) : Promise<T>
    + save(entity : T) : Promise<T>
    + delete(id : Uuid) : Promise<void>
  }
  class ClusterRepository {
    + findActive() : Promise<Cluster[]>
    + findContaining(p : GeoPoint) : Promise<Cluster>
    + findWithin(p : GeoPoint, metres : number) : Promise<Cluster[]>
    + upsertFromFeed(batch : ParsedBatch) : Promise<number>
    + appendSnapshot(s : ClusterSnapshot) : Promise<void>
  }
  class ReportRepository {
    + findByReporter(accountId : Uuid) : Promise<Report[]>
    + findPendingModeration() : Promise<Report[]>
    + findNearbyOpen(p : GeoPoint, metres : number) : Promise<Report[]>
    + findByWorkOrder(id : Uuid) : Promise<Report[]>
  }
  class WorkOrderRepository {
    + findByAssignee(accountId : Uuid) : Promise<WorkOrder[]>
    + findByCluster(id : Uuid) : Promise<WorkOrder[]>
    + findIssueFlagged() : Promise<WorkOrder[]>
    + updateStatus(id : Uuid, next : WorkOrderStatus) : Promise<WorkOrder>
  }
  class PriorityScoreRepository {
    + findLatestForAll() : Promise<PriorityScore[]>
    + findHistory(clusterId : Uuid, days : number) : Promise<PriorityScore[]>
  }
  class AccountRepository
  class SavedLocationRepository
  class AlertRepository
  class TreatmentRecordRepository
  class IngestionRunRepository
  class AuditRecordRepository
  class ObservationRepository {
    + upsertBatch(batch : ObservationRecord[]) : Promise<number>
    + countByLocality(pest : PestType, localityId : Uuid, days : number) : Promise<number>
  }
  class ReferralRepository {
    + findByReport(id : Uuid) : Promise<Referral>
    + findOpen() : Promise<Referral[]>
  }
  class OperatorRepository {
    + findAll() : Promise<VectorControlOperator[]>
    + nearestTo(p : GeoPoint) : Promise<number>
  }

  Repository <|.. ClusterRepository
  Repository <|.. ReportRepository
  Repository <|.. WorkOrderRepository
  Repository <|.. PriorityScoreRepository
  Repository <|.. AccountRepository
  Repository <|.. SavedLocationRepository
  Repository <|.. AlertRepository
  Repository <|.. TreatmentRecordRepository
  Repository <|.. IngestionRunRepository
  Repository <|.. AuditRecordRepository
  Repository <|.. ObservationRepository
  Repository <|.. ReferralRepository
  Repository <|.. OperatorRepository

  class Database <<infrastructure>> {
    + query(sql : string, params : unknown[]) : Promise<Row[]>
    + transaction(work : UnitOfWork) : Promise<void>
  }
  ClusterRepository --> Database
  ReportRepository --> Database
  WorkOrderRepository --> Database
  ObservationRepository --> Database
  ReferralRepository --> Database
}

Account "1" -- "0..5" SavedLocation
Account "1" -- "0..*" Report
Account "1" -- "0..*" WorkOrder
Cluster "1" *-- "1..*" ClusterSnapshot
Cluster "1" -- "0..*" PriorityScore
Cluster "1" -- "0..*" Report
Cluster "1" -- "0..*" WorkOrder
Cluster "1" -- "0..*" TreatmentRecord
PriorityScore "1" *-- "5..7" DriverContribution
PriorityScore "0..*" -- "1" PestProfile : scored under >
Report "0..*" -- "1" PestProfile
Report "1" -- "0..1" Referral
WorkOrder "0..*" -- "1" PestProfile
ObservationRecord "0..*" -- "1" PestProfile
ObservationRecord *-- GeoPoint
VectorControlOperator *-- GeoPoint
Account "1" -- "0..*" Referral : referred by >
Report "0..*" -- "0..1" WorkOrder : actioned by >
WorkOrder "0..*" -- "0..1" Report : raised from >
WorkOrder "1" -- "0..1" TreatmentRecord
WorkOrder "0..*" -- "0..1" Vehicle : transport by >
Account "0..*" -- "0..1" Vehicle : assigned to >
SavedLocation "1" -- "0..*" Alert
SavedLocation "0..*" -- "0..1" Cluster
Cluster *-- Polygon
Cluster *-- PremisesMix
SavedLocation *-- GeoPoint
Report *-- GeoPoint

note bottom of PriorityScore
  **5..7, not 1..7** (v0.9). A score carries one contribution
  per driver its evidence tier allows: seven for tier A, six
  for tier B, five for tier C (4.3.4 to 4.3.6). The lower
  bound is a requirement, not a convenience — 4.3.10 says a
  tier C pest scores with no external source at all, and five
  is what remains when there is none.
end note

note top of Repository
  **Repository.** One per aggregate root. The rest of the
  system never writes SQL: it asks a repository. Three
  consequences the design depends on — spatial predicates
  (ST_Contains, ST_DWithin, ST_Distance) stay in the
  database where 1.2.5, 3.1.8 and 5.1.7 belong; the
  control classes are unit-testable against in-memory
  fakes, which 10.6.3 requires; and the store could be
  replaced without touching a control class.
end note

@enduml
