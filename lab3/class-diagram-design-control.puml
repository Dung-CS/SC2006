@startuml D-Fence-DesignControl
' D-Fence — Design class model, control layer (Lab 3 deliverable 2, part 1a)
' Transformed from lab2/class-diagram-boundary-control.puml by the Fox pp. 341-345 heuristics.
' Operation signatures are TypeScript. Visibility: + public, - private, # protected.
' v0.2 (2026-09-16) - cross-pest generalisation, REQUIREMENTS.md v0.9:
'   PriorityScoringEngine split into UrgencyCalculator (the weighted sum, 4.1.7)
'   and PestPriorityCalculator (severity x urgency, 4.2.4);
'   +CriticalOverrideEvaluator (4.4), +ObservationIngestionJob (1.5),
'   +OperatorRegistryLoader (1.6), +ReferralController (8.6).
'   No new NormalisationStrategy: all four existing strategies are reused.

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle

package "Startup and configuration" #FDF7F7 {
  class AppConfigurator <<startup>> {
    - container : ServiceContainer
    + bootstrap() : Promise<void>
    + registerRepositories() : void
    + registerGateways() : void
    + registerControllers() : void
    + loadConfiguration() : Promise<ConfigSet>
    + restorePersistentState() : Promise<void>
    + shutdown() : Promise<void>
  }
  class ServiceContainer {
    - registry : Map<string, unknown>
    + register(token : string, factory : Factory) : void
    + resolve(token : string) : object
  }
  class ConfigSet {
    + driverWeights : Map<Driver, number>
    + tierThresholds : TierThresholds
    + ingestionIntervals : Map<SourceKind, number>
    + get(key : string) : string
    + requireNumber(key : string) : number
    + validate() : void
  }
  AppConfigurator *-- ServiceContainer
  AppConfigurator --> ConfigSet : loads
}

package "Access control" #FAF7FD {
  class AccessControlService <<control>> {
    - policy : AccessPolicy
    - auditRepo : AuditRecordRepository
    + authorise(principal : Principal, action : Action, resource : ResourceRef) : Promise<void>
    + may(principal : Principal, action : Action, resource : ResourceRef) : Promise<boolean>
    - denyAndLog(principal : Principal, resource : ResourceRef) : Promise<never>
  }
  class AccessPolicy {
    - matrix : Map<Role, Set<Permission>>
    + permissionsFor(role : Role) : Set<Permission>
    + isOwnershipScoped(action : Action) : boolean
  }
  class Principal {
    + accountId : Uuid
    + role : Role
    + sessionId : Uuid
  }
  AccessControlService *-- AccessPolicy
  AccessControlService ..> Principal
}

package "Scoring" #FAF7FD {
  class PestPriorityCalculator <<control>> {
    - urgency : UrgencyCalculator
    - override : CriticalOverrideEvaluator
    - profiles : PestProfileStore
    - scores : PriorityScoreStore
    + computeScores(subjects : ScoredSubject[], inputs : Map<SubjectKey, DriverInputs>, now : Date) : Promise<PriorityRanking>
    + scoreOne(subject : ScoredSubject, inputs : DriverInputs, ctx : NormalisationContext) : PriorityScore
    - applySeverity(urgency : number, profile : PestProfile) : number
    + assignTier(score : number, overridden : boolean) : PriorityTier
  }
  class UrgencyCalculator <<control>> {
    - strategies : Map<Driver, NormalisationStrategy>
    - config : ConfigSet
    - staleDrivers : Set<Driver>
    + markStale(drivers : Driver[]) : void
    + computeUrgency(subject : ScoredSubject, inputs : DriverInputs, ctx : NormalisationContext) : number
    - buildBreakdown(subject : ScoredSubject, inputs : DriverInputs, ctx : NormalisationContext) : DriverContribution[]
    - applyWeights(contributions : DriverContribution[]) : number
    - driversFor(tier : EvidenceTier) : Driver[]
    - degradeForMissingDrivers(drivers : Driver[]) : Driver[]
    - renormaliseWeights(available : Driver[]) : Map<Driver, number>
  }
  class CriticalOverrideEvaluator <<control>> {
    - rules : CriticalOverrideRule[]
    + evaluate(subject : ScoredSubject, reports : Report[]) : CriticalOverrideRule | null
    + isCritical(subject : ScoredSubject, reports : Report[]) : boolean
  }
  class CriticalOverrideRule <<value>> {
    + name : string
    + pestTypes : PestType[]
    + requiresIndoor : boolean
    + requiresInjury : boolean
    + matches(report : Report) : boolean
  }
  class ScoredSubject <<value>> {
    + localityId : Uuid
    + pestType : PestType
    + clusterId : Uuid | null
  }
  PestPriorityCalculator *-- UrgencyCalculator
  PestPriorityCalculator *-- CriticalOverrideEvaluator
  CriticalOverrideEvaluator o-- CriticalOverrideRule
  interface NormalisationStrategy <<interface>> {
    + normalise(raw : number, ctx : NormalisationContext) : number
    + driver() : Driver
  }
  class NormalisationFactory <<control>> {
    + {static} build(params : NormalisationParameters) : Map<Driver, NormalisationStrategy>
  }
  class MinMaxNormalisation {
    - target : Driver
  }
  class LogScaleNormalisation {
    - target : Driver
  }
  class CappedLinearNormalisation {
    - target : Driver
    - capValue : number
    + cap() : number
  }
  class RecencyDecayNormalisation {
    - saturationDays : number
    + saturation() : number
  }
  class PremisesMixNormalisation
  NormalisationStrategy <|.. MinMaxNormalisation
  NormalisationStrategy <|.. LogScaleNormalisation
  NormalisationStrategy <|.. CappedLinearNormalisation
  NormalisationStrategy <|.. RecencyDecayNormalisation
  NormalisationStrategy <|.. PremisesMixNormalisation
  NormalisationFactory ..> NormalisationStrategy : builds all 11 drivers
  note right of NormalisationFactory
    The four tier B/C drivers (4.1.22-4.1.25) all reuse
    CappedLinearNormalisation or LogScaleNormalisation.
    The generalisation adds NO new strategy class.
  end note

  class PriorityRanking <<container>> {
    - ordered : PriorityScore[]
    - keys : Map<Uuid, RankingKey>
    + add(score : PriorityScore, key : RankingKey) : void
    + rank() : void
    + top(n : number) : PriorityScore[]
    + byTier(tier : PriorityTier) : PriorityScore[]
    + size() : number
  }
  class RankingKey <<value>> {
    + severityMultiplier : number
    + verifiedOpenReportCount : number
    + locality : string
  }
  PriorityRanking o--> "0..*" RankingKey
  note bottom of PriorityRanking
    4.1.14 orders on four keys: score descending, then
    severity multiplier, then verified open report count,
    then locality name. The v0.8 tie-break used case size,
    which exists for the mosquito alone and so could not
    order a mixed-pest queue. The keys live outside
    PriorityScore, so the calculator supplies them rather
    than the container reaching back into a repository.
    rank() is a Lab 4 basis-path subject.
  end note
  UrgencyCalculator o--> "1..*" NormalisationStrategy : strategies
  PestPriorityCalculator --> PriorityRanking : produces
  PestPriorityCalculator --> PestProfileStore : reads profiles
}

package "Ingestion" #FAF7FD {
  abstract class AbstractIngestionJob <<control>> {
    # gateway : ExternalGateway
    # runs : IngestionRunStore
    + run(trigger : 'SCHEDULED' | 'MANUAL') : Promise<IngestionRun>
    # shouldRun() : Promise<boolean>
    # afterPersist(raw : RawPayload, batch : ParsedBatch) : Promise<void>
    # {abstract} sourceKind() : SourceKind
    # {abstract} fetch() : Promise<RawPayload>
    # {abstract} parse(raw : RawPayload) : Promise<ParsedBatch>
    # {abstract} persist(batch : ParsedBatch) : Promise<number>
    # onFailure(error : Error) : Promise<void>
    # markStale() : Promise<void>
  }
  class ClusterIngestionJob {
    - clusters : ClusterStore
    - detectChange(previous : ClusterSnapshot, current : ClusterSnapshot) : ChangeClass
  }
  class ClusterFeedParser <<control>> {
    + {static} parseHabitatList(field : string) : string[]
    + {static} computePremisesMix(homes : string[], publicPlaces : string[], sites : string[]) : number
    + {static} parseFeature(props : RawClusterProperties, geometryPresent : boolean) : ParsedCluster | RejectedFeature
    + {static} shouldDownload(metadataStamp : string, lastRecorded : string) : boolean
    + {static} featureChanged(incomingCrc : string, storedCrc : string) : boolean
    + {static} parseFeedTimestamp(fmelUpdD : string) : Date
  }
  ClusterIngestionJob ..> ClusterFeedParser : parses with
  class RainfallIngestionJob
  class ForecastIngestionJob
  class ObservationIngestionJob {
    - observations : ObservationStore
    - profiles : PestProfileStore
    + tiersServed() : EvidenceTier[]
    - rejectObscured(raw : RawObservation) : boolean
    - rejectImprecise(raw : RawObservation, maxMetres : number) : boolean
    - bindLocality(lat : number, lon : number) : Uuid | null
  }
  class OperatorRegistryLoader <<control>> {
    - operators : OperatorStore
    - geocoder : GeocodingController
    + load() : Promise<number>
    + nearestOperatorDistance(localityId : Uuid) : Promise<number>
    - geocodePostalCode(postalCode : string) : Promise<GeoPoint | null>
    - isSixDigit(postalCode : string) : boolean
  }
  AbstractIngestionJob <|-- ClusterIngestionJob
  AbstractIngestionJob <|-- RainfallIngestionJob
  AbstractIngestionJob <|-- ForecastIngestionJob
  AbstractIngestionJob <|-- ObservationIngestionJob
  note bottom of OperatorRegistryLoader
    Static reference data, loaded once and cached
    (1.6.1-1.6.7). Never presented as a live feed.
  end note

  class IngestionController <<control>> {
    - jobs : Map<SourceKind, AbstractIngestionJob>
    - publisher : DomainEventPublisher
    + runIngestion(kind : SourceKind) : Promise<IngestionRun>
    + reportSourceHealth() : Promise<SourceHealth[]>
    + resumeAfterRestart() : Promise<void>
  }
  IngestionController o--> AbstractIngestionJob
}

package "Domain events" #FAF7FD {
  class DomainEventPublisher {
    - subscribers : Map<EventKind, DomainEventSubscriber[]>
    + subscribe(kind : EventKind, s : DomainEventSubscriber) : void
    + publish(event : DomainEvent) : Promise<void>
  }
  interface DomainEventSubscriber <<interface>> {
    + handles() : EventKind[]
    + on(event : DomainEvent) : Promise<void>
  }
  class AlertTriggerEvaluator <<control>> {
    - alertRepo : AlertRepository
    - notifier : NotificationController
    + evaluateTriggers(changed : Cluster[]) : Promise<Alert[]>
    - isWithin150m(loc : SavedLocation, c : Cluster) : Promise<boolean>
    - applyDailyCap(accountId : Uuid, candidates : Alert[]) : Alert[]
  }
  DomainEventSubscriber <|.. AlertTriggerEvaluator
  DomainEventSubscriber <|.. PestPriorityCalculator
  IngestionController --> DomainEventPublisher : publishes IngestionCompleted
  DomainEventPublisher --> DomainEventSubscriber
}

package "Work-order lifecycle" #FAF7FD {
  class WorkOrderLifecycleController <<control>> {
    - table : WorkOrderTransitionTable
    - woRepo : WorkOrderRepository
    - treatmentRepo : TreatmentRecordRepository
    - notifier : NotificationController
    - scoring : PestPriorityCalculator
    + isTransitionPermitted(from : WorkOrderStatus, to : WorkOrderStatus, by : Role) : boolean
    + transition(id : Uuid, to : WorkOrderStatus, by : Principal) : Promise<WorkOrder>
    + accept(id : Uuid, by : Principal) : Promise<WorkOrder>
    + start(id : Uuid, by : Principal) : Promise<WorkOrder>
    + raiseIssue(id : Uuid, reason : string, by : Principal) : Promise<WorkOrder>
    + complete(id : Uuid, evidence : CompletionEvidence, by : Principal) : Promise<WorkOrder>
    + verify(id : Uuid, by : Principal) : Promise<TreatmentRecord>
    + rejectCompletion(id : Uuid, reason : string, by : Principal) : Promise<WorkOrder>
    + resume(id : Uuid, by : Principal) : Promise<WorkOrder>
  }
  class WorkOrderTransitionTable {
    - permitted : TransitionRule[]
    + rulesFrom(status : WorkOrderStatus) : TransitionRule[]
    + find(from : WorkOrderStatus, to : WorkOrderStatus, actor : Role) : TransitionRule
    + isTerminal(status : WorkOrderStatus) : boolean
  }
  class TransitionRule {
    + from : WorkOrderStatus
    + to : WorkOrderStatus
    + actor : Role
    + guard : Guard
    + requirement : string
    + assigneeOnly : boolean
  }
  class ReferralController <<control>> {
    - referrals : ReferralStore
    - profiles : PestProfileStore
    - publisher : DomainEventPublisher
    + refer(reportId : Uuid, actor : Principal, reason : string) : Promise<Referral>
    + recordOutcome(referralId : Uuid, outcome : string, actor : Principal) : Promise<Referral>
    + destinationFor(pestType : PestType) : DispatchAuthority
    - assertWildlife(report : Report) : void
  }
  note right of ReferralController
    Writes NO TreatmentRecord (8.6.11) and dispatches
    no crew (8.6.10): the locality was not treated.
  end note

  class DispatchController <<control>> {
    - lifecycle : WorkOrderLifecycleController
    - woRepo : WorkOrderRepository
    - reportRepo : ReportRepository
    + proposeDailyList(date : IsoDate) : Promise<DispatchProposal>
    + createWorkOrder(draft : WorkOrderDraft, by : Principal) : Promise<WorkOrder>
    + linkVerifiedReports(id : Uuid, reportIds : Uuid[]) : Promise<void>
    + assign(id : Uuid, crewId : Uuid, by : Principal) : Promise<WorkOrder>
    + reassign(id : Uuid, crewId : Uuid, by : Principal) : Promise<WorkOrder>
    + cancel(id : Uuid, reason : string, by : Principal) : Promise<WorkOrder>
  }
  WorkOrderLifecycleController *-- WorkOrderTransitionTable
  WorkOrderTransitionTable *-- "0..*" TransitionRule
  DispatchController --> WorkOrderLifecycleController : every status change
}

package "Spatial clustering and routing" #FAF7FD {
  class ReportSpatialClustering <<control>> {
    + groupNearbyReports(reports : Report[], distanceMetres : number) : ReportSpatialGroup[]
    + {static} DEFAULT_REPORT_CLUSTER_DISTANCE_METRES : number
  }
  class ReportSpatialGroup <<value>> {
    + id : string
    + reports : Report[]
    + representative : Report
    + priority : PriorityTier
    + reportIds : string[]
    + individualCounts : ReportCount[]
  }
  class RouteOptimizationService <<control>> {
    - routing : RoadRoutingStrategy
    + plan(teams : CrewTeam[], jobs : DispatchJob[], vehicles : Vehicle[], roadUnverified : GeoPoint[]) : DispatchPlan
    ' Non-road-accessible tasks are excluded and marked unplanned.
    ' No straight-line / direct-distance fallback is permitted.
  }
  interface RoadRoutingStrategy <<interface>> {
    + getRoute(origin : GeoPoint, destination : GeoPoint) : DrivingRoute
  }
  class OneMapRoadRoutingStrategy <<control>> {
    - gateway : OneMapGateway
    + getRoute(origin : GeoPoint, destination : GeoPoint) : DrivingRoute
    ' Rejects non-road-accessible points; throws RouteUnavailableError.
    ' No direct-distance fallback.
  }
  RouteOptimizationService *-- RoadRoutingStrategy
  RoadRoutingStrategy <|.. OneMapRoadRoutingStrategy
  ReportSpatialClustering ..> ReportSpatialGroup : produces
  note bottom of OneMapRoadRoutingStrategy
    **Strategy.** RoadRoutingStrategy is the interface; OneMapRoadRoutingStrategy
    is the only concrete implementation. Non-road-accessible points (e.g. offshore
    islands) raise RouteUnavailableError; the planner marks those tasks unplanned.
    Prohibiting a direct-distance fallback prevents silently incorrect routes.
  end note
  note bottom of ReportSpatialClustering
    Complete-link spatial clustering over verified Report coordinates.
    DEFAULT_REPORT_CLUSTER_DISTANCE_METRES = 100. Individual Report records
    are NOT modified; ReportSpatialGroup is a transient read-only aggregate
    consumed by DispatchController and MapViewController.
  end note
}

package "Remaining control classes (full signatures in src/control)" #FAF7FD {
  class AuthenticationController <<control>>
  class StaffAccountController <<control>>
  class SavedLocationController <<control>>
  class GeocodingController <<control>>
  class ReportController <<control>>
  class ModerationController <<control>>
  class AlertSubscriptionController <<control>>
  class NotificationController <<control>>
  class DashboardController <<control>>
}

note top of AbstractIngestionJob
  **Template Method.** run() is fixed: record start, fetch,
  parse, persist, record outcome, publish event, and on
  failure mark the source stale (10.2.2) without losing
  stored data (10.2.4). The three sources differ only in
  fetch/parse/persist, so 10.2.2 and 10.2.3 are implemented
  once instead of three times.
end note

note right of NormalisationStrategy
  **Strategy.** Requirement 4.1.4 obliges a normalisation
  method per driver and never named one — this was open
  item 1 from Lab 2. A strategy per driver settles it as a
  design decision rather than a constant buried in the
  engine, and 10.6.2 already puts the weights in
  configuration.

  **2026-09-03.** The methods and parameters are now
  written down in SCORING-SPEC.md §2, and the driver is a
  constructor parameter rather than a constant, because
  three drivers share the capped-linear method with
  different caps. NormalisationFactory owns the binding and
  asserts that all seven drivers of 4.1.3 resolve — two did
  not, which a scoring cycle would have discovered at run
  time.
end note

note bottom of ClusterFeedParser
  **Pure functions, deliberately.** Everything here is
  decided by the payload alone, so the Lab 4 cases run
  against a 2026-09-03 fixture instead of against whatever
  NEA published this morning (10.6.3).

  It exists because the feed is not shaped as the dataset
  page implies: HOMES, PUBLIC_PLACES and CONSTRUCTION_SITES
  are comma-separated habitat text, not counts, so 1.1.15
  had to be rewritten. shouldDownload() implements the
  1.1.20 metadata check that keeps the hourly cycle of
  1.1.1 cheap against a feed that moves twice a week.
end note

note bottom of WorkOrderTransitionTable
  **Table-driven state machine, deliberately not the GoF
  State pattern.** State would spread eight transitions
  across eight classes; the rule in 8.3.2 would then be
  true of the set but visible in no single place. The table
  keeps isTransitionPermitted() as one method with a
  bounded branch structure — which is also what makes it
  the Lab 4 basis-path test subject.
end note

note bottom of DomainEventPublisher
  **Observer.** Ingestion must trigger rescoring and alert
  evaluation without the jobs knowing who listens. Adding a
  subscriber later — the Lab 5 extensibility argument —
  touches no existing job.
end note

@enduml
