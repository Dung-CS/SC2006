  class PestProfile <<entity>> {
    pestType : PestType
    pestClass : PestClass
    evidenceTier : EvidenceTier
    severityMultiplier
    driverWeights
    dispatchAuthority
    observationTaxonId
    authorityContactNumber
  }
  enum PestType <<enumeration>> {
    Mosquito
    Rat
    Cockroach
    Fly
    BedBug
    Flea
    Termite
    Ant
    Snake
    WildBoar
    Macaque
    MonitorLizard
    Otter
    Civet
    Bat
    Pangolin
    Crocodile
    HouseCrow
    Pigeon
    JavanMyna
    BeeWasp
    Other
  }
  enum PestClass <<enumeration>> {
    VectorBorne
    Structural
    Nuisance
    Wildlife
