@startuml D-Fence-EntityClasses
' D-Fence — Entity class diagram (analysis model)
' SC2006/CZ2006 Lab 2 deliverable 3. Derived from ../lab1/submission/DATA-DICTIONARY.md.
' Stereotype <<entity>> per Bruegge ch. 5. Design detail (visibility, keys, methods)
' belongs to the Lab 3 design class model, not here.
' v0.3 (2026-09-16) - cross-pest generalisation, REQUIREMENTS.md v0.9:
'   +PestProfile, +ObservationRecord, +VectorControlOperator, +Referral;
'   +PestType, +PestClass, +EvidenceTier enumerations;
'   Report gains pestType, locationContext, injuryReported (5.1.15-5.1.17);
'   WorkOrder gains pestType (8.1.16); PriorityTier gains Critical (4.4.3);
'   Driver gains the four tier B/C drivers (4.1.22-4.1.25).
'   27 entity classes, 16 enumerations.

skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

package "People and access" {
  class Account <<entity>> {
    email
    passwordHash
    emailVerified
    role : Role
    isActive
    failedAttempts
    lockedUntil
    telegramChatId
    createdAt
  }
  class Session <<entity>> {
    issuedAt
    lastActiveAt
    terminatedAt
  }
  class AuditRecord <<entity>> {
    action
    targetEntity
    targetId
    occurredAt
  }
  enum Role <<enumeration>> {
    Resident
    OperationsManager
    CleaningCrew
  }
}

package "Locations and alerts" {
  class SavedLocation <<entity>> {
    inputText
    latitude
    longitude
    label : LocationLabel
    name
    exposureStatus : ExposureStatus
    rain24hMm
    rain72hMm
    evaluatedAt
  }
  class AlertSubscription <<entity>> {
    enabled
    growthThreshold
  }
  class Alert <<entity>> {
    triggerType : AlertTrigger
    sentAt
    outcome
    payload
  }
  enum LocationLabel <<enumeration>> {
    Home
    Workplace
    School
    Other
  }
  enum ExposureStatus <<enumeration>> {
    IN_CLUSTER
    WITHIN_150M
    CLEAR
  }
  enum AlertTrigger <<enumeration>> {
    EnteredCluster
    ClusterGrowth
    HeavyRainForecast
  }
}

package "Clusters and environment" {
  class Cluster <<entity>> {
    objectId
    locality
    boundary
    caseSize
    homes
    publicPlaces
    constructionSites
    premisesMix
    caseDelta
    changeClass : ChangeClass
    forecastRegion : ForecastRegion
    heavyRainExpected
    trajectory : Trajectory
    firstSeenAt
    lastUpdatedAt
    isActive
  }
  class ClusterSnapshot <<entity>> {
    retrievedAt
    caseSize
    homes
    publicPlaces
    constructionSites
    boundary
    fmelUpdD
  }
  class RainfallStation <<entity>> {
    stationId
    name
    latitude
    longitude
  }
  class RainfallReading <<entity>> {
    readingAt
    valueMm
  }
  class ClusterRainfall <<entity>> {
    currentMm
    accum24hMm
    accum72hMm
    isStale
  }
  class RegionForecast <<entity>> {
    region : ForecastRegion
    forecastText
    heavyRainExpected
    validFrom
    validTo
  }
  enum ChangeClass <<enumeration>> {
    NEW
    GROWN
    UNCHANGED
    SHRUNK
    CLOSED
  }
  enum ForecastRegion <<enumeration>> {
    north
    south
    east
    west
    central
  }
  enum Trajectory <<enumeration>> {
    Growing
    Stable
    Receding
  }
}

package "Scoring" {
  class PriorityScore <<entity>> {
    computedAt
    score
    tier : PriorityTier
    isDegraded
    excludedDrivers
    rank
  }
  class DriverContribution <<entity>> {
    driver : Driver
    rawValue
    normalisedValue
    weight
    contribution
  }
  enum PriorityTier <<enumeration>> {
    Critical
    High
    Medium
    Low
  }
  enum Driver <<enumeration>> {
    CaseSize
    CaseGrowthDelta
    Rainfall24h
    Rainfall72h
    VerifiedOpenReportCount
    DaysSinceLastTreatment
    PremisesMix
    ReportVelocity
    CorroborationDensity
    ExternalObservationDensity
    ResponseCapacityDeficit
