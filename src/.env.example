# D-Fence — environment template. Copy to src/.env and fill in.
# src/.env is gitignored (10.3.4): no secret may ever be committed.

# --- OneMap (geocoding, 3.1.3) -------------------------------------------------
# Register at https://www.onemap.gov.sg/apidocs/register
# Either paste a token (expires 3 days after it is minted) …
ONE_MAP_TOKEN=""
# … or supply the account credentials, and the gateway mints and refreshes its own.
ONE_MAP_EMAIL=""
ONE_MAP_PASSWORD=""

# --- Supabase (auth, storage, Postgres) ----------------------------------------
# Not yet provisioned. The anon key is the browser's; the service key is server-side only.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
DATABASE_URL=""

# --- Telegram (resident alerts, 6.1.6) -----------------------------------------
TELEGRAM_BOT_TOKEN=""

# Possible duplicate report grouping: maximum distance between every pair, 1-1000 metres.
DFENCE_REPORT_CLUSTER_DISTANCE_METRES=100

# Optional server-side photo detection; leave the key blank for manual reporting.
# Provider is allowlisted: gemini-developer (default) or vertex-express. For Vertex Express,
# set DFENCE_VISION_MODEL to a model confirmed for the target project before enabling it.
DFENCE_VISION_PROVIDER=gemini-developer
DFENCE_VISION_API_KEY=
DFENCE_VISION_MODEL=gemini-3.8-flash
